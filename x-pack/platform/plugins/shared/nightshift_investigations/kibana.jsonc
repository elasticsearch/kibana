{
  "type": "plugin",
  "id": "@kbn/nightshift-investigations-plugin",
  "owner": ["@elastic/nightshift-context-and-research-team", "@elastic/nightshift-sre-agent-team"],
  "group": "platform",
  "visibility": "shared",
  "description": "Nightshift Investigations — domain API for starting and reading investigations",
  "plugin": {
    "id": "nightshiftInvestigations",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "nightshift_investigations"],
    "requiredPlugins": [
      "taskManager"
    ],
    "optionalPlugins": [
      "actions",
      "agentBuilder",
      "contextEngine",
      "inference",
      "ruleRegistry",
      "searchInferenceEndpoints",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement",
    ],
    "requiredBundles": [],
    "extraPublicDirs": ["common"]
  },
}
