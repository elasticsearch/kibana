            "enum": Array [
              "info",
              "low",
              "medium",
              "high",
              "critical",
            ],
            "type": "string",
          },
          "source": Object {
            "description": "Origin of the alert events for this episode (e.g. \`internal\`)",
            "type": "string",
          },
