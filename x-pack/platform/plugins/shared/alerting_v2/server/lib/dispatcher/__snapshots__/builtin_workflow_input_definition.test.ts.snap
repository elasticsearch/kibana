          "rule_id",
          "source",
          "space_id",
          "group_hash",
          "episode_id",
          "episode_status",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "groupKey": Object {
      "additionalProperties": true,
      "description": "Grouping key for the notification group. This is currently generated by the dispatcher and may vary depending on grouping behavior.",
      "type": "object",
    },
    "id": Object {
