exports[`UploadLicense should display a modal when license requires acknowledgement 1`] = `
<DocumentFragment>
  <div
    class="css-zkj008-root"
    data-test-subj="appHeader"
  >
    <div
      class="css-t797kc-primaryRow"
    >
      <div
        class="css-1put8yh-titleCluster"
      >
        <div
          class="css-eg0b7t-titleGroup"
        >
          <div
            class="css-154m2kl"
          >
            <span
              class="euiToolTipAnchor emotion-euiToolTipAnchor-inlineBlock"
              id="generated-id-wrapper"
            >
              <a
                aria-label="Back to License management"
                class="euiButtonIcon emotion-euiButtonIcon-xs-empty-text-button"
                data-test-subj="appHeaderBack"
                href="/"
                rel="noreferrer"
              >
                <span
                  aria-hidden="true"
                  class="euiButtonIcon__icon"
                  color="inherit"
                  data-euiicon-type="sortLeft"
                />
              </a>
            </span>
            <div
              class="css-fsoqfw-titleWrapper"
            >
              <h1
                class="euiTitle emotion-euiTitle-s"
              >
                <span
                  class="css-1lv2mba-titleFrame"
                >
                  <span
                    aria-hidden="true"
                    class="css-17v8vwb-titleSizer"
                  >
                    Upload your license
                  </span>
                  <span
                    class="css-t9u6rw-titleText"
                    data-test-subj="appHeaderTitle"
                  >
                    Upload your license
                  </span>
                </span>
              </h1>
            </div>
          </div>
          <div
            class="titleActionsReveal css-1oeh8gv-titleActionsReveal"
          />
        </div>
        <div
          aria-hidden="true"
          class="css-8yzqxk-titleClusterSpacer"
        />
      </div>
      <div
        class="css-m8xpyo-trailingSlot"
      />
    </div>
  </div>
  <section
    class="emotion-euiPageSection-grow-l-center-transparent"
  >
    <div
      class="emotion-euiPageSection__content-l-center"
    >
      <div
        class="euiPanel euiPanel--subdued euiPanel--paddingLarge emotion-euiPanel-grow-m-l-subdued"
      >
        <div
          class="euiText emotion-euiText-m"
        >
          <p>
            Your license key is a JSON file with a signature attached.
          </p>
          <p>
            Uploading a license will replace your current 
            <strong />
             license.
          </p>
        </div>
        <div
          class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
        />
        <div
          class="euiForm"
        >
          <div
            class="euiFilePicker emotion-euiFilePicker-fullWidth"
          >
            <input
              aria-describedby="licenseFile-filePicker__prompt"
              aria-label="License file"
              class="euiFilePicker__input emotion-euiFilePicker__input-largeInteractive"
              id="licenseFile"
              type="file"
            />
            <div
              class="euiFilePicker__prompt emotion-euiFilePicker__prompt-large"
              id="licenseFile-filePicker__prompt"
            >
              <span
                aria-hidden="true"
                class="euiFilePicker__icon emotion-euiFilePicker__icon-large"
                color="text"
                data-euiicon-type="upload"
              />
              <span
                class="euiFilePicker__promptText"
              >
                Select or drag your license file
              </span>
            </div>
          </div>
          <div
            class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
          />
          <div
            class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
          />
          <div
            class="euiFlexGroup emotion-euiFlexGroup-responsive-m-spaceBetween-stretch-row"
          >
            <div
              class="euiFlexItem emotion-euiFlexItem-growZero"
            >
              <a
                class="euiButtonEmpty emotion-euiButtonDisplay-euiButtonEmpty-m-empty-primary"
                data-test-subj="cancelUploadButton"
                href="/home"
                rel="noreferrer"
              >
                <span
                  class="euiButtonEmpty__content emotion-euiButtonDisplayContent"
                >
                  <span
                    class="eui-textTruncate euiButtonEmpty__text css-13ifi6d-m"
                  >
                    Cancel
                  </span>
                </span>
              </a>
            </div>
            <div
              class="euiFlexItem emotion-euiFlexItem-growZero"
            >
              <button
                class="euiButton emotion-euiButtonDisplay-m-defaultMinWidth-fill-primary"
                data-test-subj="uploadLicenseButton"
                type="button"
              >
                <span
                  class="emotion-euiButtonDisplayContent"
                >
                  Upload
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</DocumentFragment>
`;

