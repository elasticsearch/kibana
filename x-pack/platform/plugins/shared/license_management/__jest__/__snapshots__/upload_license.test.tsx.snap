      >
        <div
          class="euiText emotion-euiText-m"
        >
          <p>
            Your license key is a JSON file with a signature attached.
          </p>
          <p>
            Uploading a license will replace your current 
            <strong />
             license.
          </p>
        </div>
        <div
          class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
        />
        <div
