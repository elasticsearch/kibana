                data-test-subj="cancelUploadButton"
                href="/home"
                rel="noreferrer"
              >
                <span
                  class="euiButtonEmpty__content emotion-euiButtonDisplayContent"
                >
                  <span
                    class="eui-textTruncate euiButtonEmpty__text css-13ifi6d-m"
