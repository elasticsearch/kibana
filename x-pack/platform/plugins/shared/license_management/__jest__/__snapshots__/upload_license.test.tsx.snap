                      >
                        Error encountered uploading license: Can not upgrade to a production license unless TLS is configured or security is disabled
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
          />
          <div
