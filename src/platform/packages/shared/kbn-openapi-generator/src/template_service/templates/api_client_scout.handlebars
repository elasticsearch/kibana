import type { ApiClientFixture, ApiClientResponse } from '@kbn/scout';
import { ELASTIC_HTTP_VERSION_HEADER, X_ELASTIC_INTERNAL_ORIGIN_REQUEST } from '@kbn/core-http-common';
import { replaceParams } from '@kbn/openapi-common/shared';
import { stringify as stringifyQuery } from 'query-string';

{{#each operations}}
{{#if (or requestQuery requestParams requestBody response)}}
import type {
  {{~#if requestQuery}}{{operationId}}RequestQueryInput,{{/if}}
  {{~#if requestParams}}{{operationId}}RequestParamsInput,{{/if}}
  {{~#if requestBody}}{{operationId}}RequestBodyInput,{{/if}}
  {{~#if response}}{{operationId}}Response,{{/if}}
} from '{{replace sourcePath 'schema.yaml' 'gen'}}';
{{/if}}
