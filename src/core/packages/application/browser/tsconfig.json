{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@kbn/ambient-ui-types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
  "kbn_references": [
    "@kbn/utility-types",
    "@kbn/core-theme-browser",
    "@kbn/core-mount-utils-browser",
    "@kbn/core-capabilities-common",
    "@kbn/core-application-common",
    "@kbn/i18n",
    "@kbn/i18n-react",
    "@kbn/test-jest-helpers"
  ],
  "exclude": [
    "target/**/*",
  ]
}
