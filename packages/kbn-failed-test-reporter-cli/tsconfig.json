{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
  ],
  "kbn_references": [
    "@kbn/ci-stats-reporter",
    "@kbn/code-owners",
    "@kbn/dev-cli-runner",
    "@kbn/dev-cli-errors",
    "@kbn/tooling-log",
    "@kbn/ftr-screenshot-filename",
    "@kbn/jest-serializers",
    "@kbn/journeys",
    "@kbn/repo-info",
    "@kbn/scout-reporting",
  ],
  "exclude": [
    "target/**/*",
  ]
}
